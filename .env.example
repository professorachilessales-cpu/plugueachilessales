# 1. Banco de Dados Turso (LibSQL Cloud)
TURSO_DATABASE_URL="libsql://plugueachiles-achilessales.aws-us-west-2.turso.io"
# Cole o seu Auth Token gerado via painel do Turso ou CLI (`turso db tokens create plugueachiles`)
TURSO_AUTH_TOKEN=""

# 2. Google Drive OAuth 2.0 (Armazenamento em Nuvem & Storage API)
GOOGLE_CLIENT_ID="123456789-abcdef.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# 3. Google Drive Service Account (Alternativa / Credenciais de Servidor)
GOOGLE_SERVICE_ACCOUNT_EMAIL="school-os-service@project-id.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_PARENT_FOLDER_ID=""

# 4. Supabase (Legado / Opcional)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 5. Assistência de Redação Pedagógica (Groq, somente no servidor)
# Na Vercel, cadastrar GROQ_API_KEY em Production e fazer um novo deploy.
GROQ_API_KEY=""
# Opcional: se ausente, o código usa qwen/qwen3.8-27b.
GROQ_MODEL="qwen/qwen3.8-27b"
